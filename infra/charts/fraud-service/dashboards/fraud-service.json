{
  "uid": "fraud-service",
  "title": "Fraud Service",
  "schemaVersion": 39,
  "version": 1,
  "tags": [
    "fraud-service"
  ],
  "refresh": "30s",
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "panels": [
    {
      "id": 1,
      "title": "Prediction rate",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "__METRICS_UID__"
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 0,
        "y": 0
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "__METRICS_UID__"
          },
          "expr": "sum by (is_fraud) (rate(predictions_total{namespace=\"__NAMESPACE__\",job=\"__RELEASE__\"}[5m]))",
          "format": "time_series",
          "legendFormat": "{{is_fraud}}"
        }
      ]
    },
    {
      "id": 2,
      "title": "Prediction latency (p95)",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "__METRICS_UID__"
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 8,
        "y": 0
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "__METRICS_UID__"
          },
          "expr": "histogram_quantile(0.95, sum by (le) (rate(prediction_latency_seconds_bucket{namespace=\"__NAMESPACE__\",job=\"__RELEASE__\"}[5m])))",
          "format": "time_series",
          "legendFormat": "p95"
        }
      ]
    },
    {
      "id": 3,
      "title": "Fraud score distribution",
      "type": "heatmap",
      "datasource": {
        "type": "prometheus",
        "uid": "__METRICS_UID__"
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 16,
        "y": 0
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "__METRICS_UID__"
          },
          "expr": "sum by (le) (increase(fraud_prediction_score_bucket{namespace=\"__NAMESPACE__\",job=\"__RELEASE__\"}[5m]))",
          "format": "heatmap",
          "legendFormat": "{{le}}"
        }
      ],
      "options": {
        "calculate": false
      }
    },
    {
      "id": 4,
      "title": "Fraud service logs",
      "type": "logs",
      "datasource": {
        "type": "victoriametrics-logs-datasource",
        "uid": "__LOGS_UID__"
      },
      "gridPos": {
        "h": 12,
        "w": 24,
        "x": 0,
        "y": 8
      },
      "options": {
        "enableLogDetails": true,
        "showTime": true,
        "sortOrder": "Descending",
        "wrapLogMessage": true
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "victoriametrics-logs-datasource",
            "uid": "__LOGS_UID__"
          },
          "editorMode": "code",
          "expr": "kubernetes.pod_namespace:=\"__NAMESPACE__\" AND service:=\"__SERVICE__\"",
          "queryType": "instant",
          "maxLines": 500
        }
      ]
    },
    {
      "id": 5,
      "title": "Request trace links",
      "type": "table",
      "datasource": {
        "type": "victoriametrics-logs-datasource",
        "uid": "__LOGS_UID__"
      },
      "gridPos": {
        "h": 8,
        "w": 24,
        "x": 0,
        "y": 20
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "victoriametrics-logs-datasource",
            "uid": "__LOGS_UID__"
          },
          "editorMode": "code",
          "expr": "kubernetes.pod_namespace:=\"__NAMESPACE__\" AND service:=\"__SERVICE__\" AND trace_id:* | fields _time, event, trace_id",
          "queryType": "instant",
          "maxLines": 100
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "trace_id"
            },
            "properties": [
              {
                "id": "links",
                "value": [
                  {
                    "title": "View trace",
                    "url": "/explore?schemaVersion=1&panes=%7B%22trace%22%3A%7B%22datasource%22%3A%22__TRACES_UID__%22%2C%22queries%22%3A%5B%7B%22refId%22%3A%22A%22%2C%22datasource%22%3A%7B%22type%22%3A%22tempo%22%2C%22uid%22%3A%22__TRACES_UID__%22%7D%2C%22queryType%22%3A%22traceql%22%2C%22query%22%3A%22${__value.raw}%22%7D%5D%2C%22range%22%3A%7B%22from%22%3A%22now-1h%22%2C%22to%22%3A%22now%22%7D%7D%7D"
                  },
                  {
                    "title": "Logs for this trace",
                    "url": "/explore?schemaVersion=1&panes=%7B%22trace%22%3A%7B%22datasource%22%3A%22__LOGS_UID__%22%2C%22queries%22%3A%5B%7B%22refId%22%3A%22A%22%2C%22datasource%22%3A%7B%22type%22%3A%22victoriametrics-logs-datasource%22%2C%22uid%22%3A%22__LOGS_UID__%22%7D%2C%22queryType%22%3A%22instant%22%2C%22expr%22%3A%22kubernetes.pod_namespace%3A%3D%5C%22__NAMESPACE__%5C%22%20AND%20service%3A%3D%5C%22__SERVICE__%5C%22%20AND%20trace_id%3A%3D%5C%22${__value.raw}%5C%22%22%7D%5D%2C%22range%22%3A%7B%22from%22%3A%22now-1h%22%2C%22to%22%3A%22now%22%7D%7D%7D"
                  }
                ]
              }
            ]
          }
        ]
      },
      "transformations": [
        {
          "id": "extractFields",
          "options": {
            "source": "labels",
            "format": "json",
            "replace": true,
            "keepTime": true
          }
        }
      ]
    }
  ]
}

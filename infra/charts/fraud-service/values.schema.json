{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "required": ["telemetry"],
  "properties": {
    "telemetry": {
      "type": "object",
      "required": ["serviceName"],
      "properties": {
        "serviceName": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.-]*$"
        }
      }
    },
    "service": {
      "type": "object",
      "required": ["type"],
      "properties": {
        "type": {
          "const": "ClusterIP"
        }
      }
    }
  }
}

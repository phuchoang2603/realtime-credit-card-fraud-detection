{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ListHistoricalVersions",
      "Effect": "Allow",
      "Action": [
        "s3:ListBucket"
      ],
      "Resource": [
        "arn:aws:s3:::synthetic-source"
      ]
    },
    {
      "Sid": "WriteHistoricalObjects",
      "Effect": "Allow",
      "Action": [
        "s3:GetObject",
        "s3:PutObject",
        "s3:AbortMultipartUpload",
        "s3:ListMultipartUploadParts"
      ],
      "Resource": ["arn:aws:s3:::synthetic-source/historical/*"]
    }
  ]
}
